datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}
model User {
  id              Int        @id @default(autoincrement())
  role            Role
  name            String     @unique
  phone           String?
  passwordHash    String

  // Account status & permissions
  status              Status     @default(ACTIVE)
  portalAccess        Boolean    @default(true)
  transactionAllowed  Boolean    @default(true)

  // Merchant specific fields
  upiId           String?
  qrCodeUrl       String?
  brokerId        Int?
  broker          User?      @relation("BrokerMerchants", fields: [brokerId], references: [id])
  brokeredMerchants User[]   @relation("BrokerMerchants")

  // PAYIN / Deposit Fee Configuration (%)
  payinMerchantFee    Float     @default(0.0)
  payinQrProviderFee  Float     @default(0.0)
  payinAgentFee       Float     @default(0.0)
  payinBrokerFee      Float     @default(0.0)

  // PAYOUT / Withdrawal Fee Configuration (%)
  payoutMerchantFee   Float     @default(0.0)
  payoutQrProviderFee Float     @default(0.0)
  payoutAgentFee      Float     @default(0.0)
  payoutBrokerFee     Float     @default(0.0)

  // Agent specific fields
  commissionPercent Float   @default(1.0)
  agentQrProviders User[]   @relation("AgentQRProviders")

  // QR Provider & Merchant Liquidity & Balances (Single Source of Truth)
  agentId          Int?
  agent            User?     @relation("AgentQRProviders", fields: [agentId], references: [id])
  balance          Float     @default(0.0)
  exposure         Float     @default(0.0)
  availableBalance Float     @default(0.0)
  credit           Float     @default(0.0)
  qrProviderFee    Float     @default(3.0)

  // Operator relationship (QR Provider <-> Operators)
  qrProviderId        Int?
  qrProvider          User?     @relation("ProviderOperators", fields: [qrProviderId], references: [id])
  operators           User[]    @relation("ProviderOperators")
  assignedQRCodes     QRCode[]  @relation("OperatorAssignedQRCodes")

  // Relations
  qrCodes         QRCode[]      @relation("ProviderQRCodes")
  transactions    Transaction[] @relation("UserTransactions")
  merchantOrders  Order[]       @relation("MerchantOrders")
  providerOrders  Order[]       @relation("ProviderOrders")
  verifiedOrders  Order[]       @relation("VerifiedOrders")
  auditLogs       AuditLog[]

  // Merchant API & Webhook Configuration
  webhookUrl         String?
  defaultSuccessUrl  String?
  defaultFailureUrl  String?
  apiKeys            ApiKey[]

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model QRCode {
  id                Int      @id @default(autoincrement())
  providerId        Int
  provider          User     @relation("ProviderQRCodes", fields: [providerId], references: [id], onDelete: Cascade)
  operatorId        Int?
  operator          User?    @relation("OperatorAssignedQRCodes", fields: [operatorId], references: [id], onDelete: SetNull)
  upiId             String
  imageUrl          String
  name              String?
  accountHolderName String?
  bankName          String?
  status            Status   @default(ACTIVE)
  isActive          Boolean  @default(true)
  orders            Order[]  @relation("AssignedQRCode")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Transaction {
  id           Int                  @id @default(autoincrement())
  userId       Int
  user         User                 @relation("UserTransactions", fields: [userId], references: [id], onDelete: Cascade)
  orderId      Int?
  order        Order?               @relation("OrderTransactions", fields: [orderId], references: [id], onDelete: SetNull)
  type         TransactionType
  category     TransactionCategory?
  amount       Float
  balanceAfter Float
  description  String
  createdAt    DateTime             @default(now())

  @@index([userId])
  @@index([orderId])
}

model Order {
  id                 Int           @id @default(autoincrement())
  orderNumber        String        @unique
  merchantId         Int
  merchant           User          @relation("MerchantOrders", fields: [merchantId], references: [id])
  qrProviderId       Int?
  qrProvider         User?         @relation("ProviderOrders", fields: [qrProviderId], references: [id])
  qrCodeId           Int?
  qrCode             QRCode?       @relation("AssignedQRCode", fields: [qrCodeId], references: [id])
  
  amount             Float
  remark             String?

  status             OrderStatus   @default(pending)
  type               OrderType
  
  // Customer submission
  customerUtr        String?
  customerScreenshot String?

  // Payout specific fields
  beneficiaryDetails String?
  payoutBroadcast    Boolean       @default(false)
  payoutProofUtr     String?
  payoutProofImage   String?
  payoutPaidBy       String?

  // Verification submission (QR Provider or Admin)
  verifierUtr        String?
  verifierScreenshot String?
  verifiedById       Int?
  verifiedBy         User?         @relation("VerifiedOrders", fields: [verifiedById], references: [id])

  // Fee rates snapshot (% applied at order creation)
  merchantFeeRate    Float         @default(0.0)
  qrProviderFeeRate  Float         @default(0.0)
  agentFeeRate       Float         @default(0.0)
  brokerFeeRate      Float         @default(0.0)
  platformFeeRate    Float         @default(0.0)

  // Fee amount snapshots upon calculation/settlement
  merchantFee        Float         @default(0.0)
  agentFee           Float         @default(0.0)
  qrProviderFee      Float         @default(0.0)
  brokerFee          Float         @default(0.0)
  platformFee        Float         @default(0.0)
  totalFees          Float         @default(0.0)

  // Merchant API tracking & Checkout redirects
  clientOrderId      String?
  successUrl         String?
  failureUrl         String?
  webhookUrl         String?
  checkoutState      CheckoutState @default(ACTIVE)

  transactions       Transaction[] @relation("OrderTransactions")
  webhookDeliveries  WebhookDelivery[]

  expiresAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([merchantId, clientOrderId])
}

model ApiKey {
  id             Int          @id @default(autoincrement())
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  keyId          String       @unique
  secretHash     String
  secretMasked   String
  
  name           String       @default("Production API Key")
  status         ApiKeyStatus @default(ACTIVE)
  permissions    String       @default("PAYIN,PAYOUT,READ")
  
  whitelistedIps String?
  rateLimit      Int          @default(60)
  
  lastUsedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId])
  @@index([keyId])
}

model WebhookDelivery {
  id           Int           @id @default(autoincrement())
  merchantId   Int
  orderId      Int?
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  event        String
  targetUrl    String
  
  payload      String
  signature    String
  
  status       WebhookStatus @default(PENDING)
  attempts     Int           @default(0)
  maxAttempts  Int           @default(5)
  responseCode Int?
  responseBody String?
  errorMessage String?
  
  nextRetryAt  DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([merchantId])
  @@index([orderId])
  @@index([status, nextRetryAt])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entity     String
  entityId   String?
  metadata   String?
  createdAt  DateTime @default(now())
}

enum Role {
  ADMIN
  MERCHANT
  AGENT
  QR_PROVIDER
  BROKER
  OPERATOR
  OTHER
}

enum Status {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  pending
  processing
  completed
  rejected
  expired
  cancelled
}

enum OrderType {
  PAYIN
  PAYOUT
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
}

enum TransactionCategory {
  ORDER_CREDIT
  ORDER_DEBIT
  MERCHANT_FEE
  QR_PROVIDER_FEE
  AGENT_COMMISSION
  BROKER_COMMISSION
  DEPOSIT
  WITHDRAWAL
  ADD_CREDIT
  DEDUCT_CREDIT
  HAWALA_TRANSFER
  HAWALA_RECEIPT
  INITIAL_BALANCE
}

enum ApiKeyStatus {
  ACTIVE
  INACTIVE
  REVOKED
}

enum WebhookStatus {
  PENDING
  DELIVERED
  FAILED
}

enum CheckoutState {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}
