datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              Int       @id @default(autoincrement())
  role            String    // "ADMIN" | "MERCHANT" | "AGENT" | "QR_PROVIDER" | "BROKER"
  name            String    @unique
  phone           String?
  address         String?
  telegramId      String?
  passwordHash    String

  // Account status & permissions
  status              String    @default("ACTIVE") // "ACTIVE" | "INACTIVE"
  portalAccess        Boolean   @default(true)
  transactionAllowed  Boolean   @default(true)

  // Merchant specific fields
  upiId           String?
  qrCodeUrl       String?
  brokerId        Int?
  broker          User?     @relation("BrokerMerchants", fields: [brokerId], references: [id])
  brokeredMerchants User[]  @relation("BrokerMerchants")

  // PAYIN / Deposit Fee Configuration (%)
  payinMerchantFee    Float     @default(0.0)
  payinQrProviderFee  Float     @default(0.0)
  payinAgentFee       Float     @default(0.0)
  payinBrokerFee      Float     @default(0.0)

  // PAYOUT / Withdrawal Fee Configuration (%)
  payoutMerchantFee   Float     @default(0.0)
  payoutQrProviderFee Float     @default(0.0)
  payoutAgentFee      Float     @default(0.0)
  payoutBrokerFee     Float     @default(0.0)

  // Agent specific fields
  commissionPercent Float   @default(1.0) // Percentage, e.g. 1%
  agentQrProviders User[]   @relation("AgentQRProviders")

  // QR Provider specific fields
  agentId         Int?
  agent           User?     @relation("AgentQRProviders", fields: [agentId], references: [id])
  balance         Float     @default(0.0)
  exposure        Float     @default(0.0)
  availableBalance Float    @default(0.0)
  credit          Float     @default(0.0)
  qrProviderFee   Float     @default(3.0) // Percentage, e.g. 3%

  // Operator relationship (QR Provider <-> Operators)
  qrProviderId        Int?
  qrProvider          User?     @relation("ProviderOperators", fields: [qrProviderId], references: [id])
  operators           User[]    @relation("ProviderOperators")
  assignedQRCodes     QRCode[]  @relation("OperatorAssignedQRCodes")

  // Relations
  qrCodes         QRCode[]  @relation("ProviderQRCodes")
  wallet          Wallet?
  merchantOrders  Order[]   @relation("MerchantOrders")
  providerOrders  Order[]   @relation("ProviderOrders")
  verifiedOrders  Order[]   @relation("VerifiedOrders")
  auditLogs       AuditLog[]

  // Merchant API & Webhook Configuration
  webhookUrl         String?
  defaultSuccessUrl  String?
  defaultFailureUrl  String?
  apiKeys            ApiKey[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model QRCode {
  id                Int         @id @default(autoincrement())
  providerId        Int
  provider          User        @relation("ProviderQRCodes", fields: [providerId], references: [id], onDelete: Cascade)
  operatorId        Int?
  operator          User?       @relation("OperatorAssignedQRCodes", fields: [operatorId], references: [id], onDelete: SetNull)
  upiId             String
  imageUrl          String
  name              String?     // e.g. Primary ICICI QR
  accountHolderName String?
  bankName          String?
  status            String      @default("ACTIVE") // "ACTIVE" | "INACTIVE"
  isActive          Boolean     @default(true)
  orders            Order[]     @relation("AssignedQRCode")

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model Wallet {
  id           Int           @id @default(autoincrement())
  userId       Int           @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Float         @default(0.0)
  entries      LedgerEntry[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model LedgerEntry {
  id           Int           @id @default(autoincrement())
  walletId     Int
  wallet       Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  orderId      Int?
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type         String        // "CR" | "DR"
  category     String?       // "ORDER_CREDIT" | "MERCHANT_FEE" | "QR_PROVIDER_FEE" | "AGENT_COMMISSION" | "BROKER_COMMISSION"
  amount       Float
  balanceAfter Float
  description  String
  createdAt    DateTime      @default(now())
}

model Order {
  id                 Int           @id @default(autoincrement())
  orderNumber        String        @unique
  merchantId         Int
  merchant           User          @relation("MerchantOrders", fields: [merchantId], references: [id])
  qrProviderId       Int?
  qrProvider         User?         @relation("ProviderOrders", fields: [qrProviderId], references: [id])
  qrCodeId           Int?
  qrCode             QRCode?       @relation("AssignedQRCode", fields: [qrCodeId], references: [id])
  
  amount             Float
  customerName       String
  customerMobile     String
  customerEmail      String?
  remark             String?

  status             String        @default("pending") // pending | processing | completed | rejected | expired | cancelled
  type               String        // PAYIN | PAYOUT
  
  // Customer submission
  customerUtr        String?
  customerScreenshot String?

  // Payout specific fields
  beneficiaryDetails String?
  customerUpiId      String?
  customerQrImage    String?
  payoutBroadcast    Boolean       @default(false)
  payoutProofUtr     String?
  payoutProofImage   String?
  payoutPaidBy       String?       // "ADMIN" | "QR_PROVIDER"

  // Verification submission (QR Provider or Admin)
  verifierUtr        String?
  verifierScreenshot String?
  verifiedById       Int?
  verifiedBy         User?         @relation("VerifiedOrders", fields: [verifiedById], references: [id])

  // Fee rates snapshot (% applied at order creation)
  merchantFeeRate    Float         @default(0.0)
  qrProviderFeeRate  Float         @default(0.0)
  agentFeeRate       Float         @default(0.0)
  brokerFeeRate      Float         @default(0.0)
  platformFeeRate    Float         @default(0.0)

  // Fee amount snapshots upon calculation/settlement
  merchantFee        Float         @default(0.0)
  agentFee           Float         @default(0.0)
  qrProviderFee      Float         @default(0.0)
  brokerFee          Float         @default(0.0)
  platformFee        Float         @default(0.0)
  totalFees          Float         @default(0.0)

  // Merchant API tracking & Checkout redirects
  clientOrderId      String?       // Merchant external reference / idempotency key
  successUrl         String?       // Order-specific success redirect URL
  failureUrl         String?       // Order-specific failure redirect URL
  webhookUrl         String?       // Order-specific webhook callback URL
  checkoutState      String        @default("ACTIVE") // "ACTIVE" | "COMPLETED" | "EXPIRED" | "CANCELLED"

  ledgerEntries      LedgerEntry[]
  webhookDeliveries  WebhookDelivery[]

  expiresAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([merchantId, clientOrderId])
}

model ApiKey {
  id             Int       @id @default(autoincrement())
  userId         Int
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  keyId          String    @unique // e.g. "27_686148"
  secretHash     String    // Encrypted AES-256-GCM ciphertext of the apiSecret
  secretMasked   String    // e.g. "1a24d210...fb76" for UI identification
  
  name           String    @default("Production API Key")
  status         String    @default("ACTIVE") // "ACTIVE" | "INACTIVE" | "REVOKED"
  permissions    String    @default("PAYIN,PAYOUT,READ") // Comma-separated permissions
  
  whitelistedIps String?   // Comma-separated IPv4/IPv6 addresses, or null for all IPs
  rateLimit      Int       @default(60) // Allowed requests per minute
  
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([keyId])
}

model WebhookDelivery {
  id           Int       @id @default(autoincrement())
  merchantId   Int
  orderId      Int?
  order        Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  event        String    // "order.payin.completed" | "order.payin.rejected" | "order.payout.completed" | "order.payout.rejected"
  targetUrl    String
  
  payload      String    // JSON stringified payload
  signature    String    // HMAC-SHA256 signature generated with merchant secret
  
  status       String    @default("PENDING") // "PENDING" | "DELIVERED" | "FAILED"
  attempts     Int       @default(0)
  maxAttempts  Int       @default(5)
  responseCode Int?
  responseBody String?
  errorMessage String?
  
  nextRetryAt  DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([merchantId])
  @@index([orderId])
  @@index([status, nextRetryAt])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // e.g. "LOGIN", "CREATE_ORDER", "VERIFY_UTR", "RESET_PASSWORD"
  entity     String   // e.g. "Order", "User", "Wallet"
  entityId   String?
  metadata   String?  // JSON stringified details
  createdAt  DateTime @default(now())
}
